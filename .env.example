# AI Brain Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Vault Directory Path (Path to local folder containing your resumes and documents)
VAULT_DIR=C:/path/to/your/documents_folder

# Database
DATABASE_URL=sqlite:///./nirantar.db

# Browser Automation
HEADLESS=false
BROWSER_TIMEOUT_MS=30000
SLOW_MO_MS=150
AGENT_BORDER_GLOW=true

# Notification & Tracking
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Inbox Tracker (Gmail App Password)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
